<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>GHelper.Shared</AssemblyName>
    <RootNamespace>GHelper</RootNamespace>
    <DebugType>embedded</DebugType>
    <OutputPath>bin\x64\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\x64\$(Configuration)\</IntermediateOutputPath>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    The WinForms head gets System.Drawing implicitly from UseWindowsForms. This project cannot
    set that, so it declares the same implicit using explicitly; System.Drawing.Color itself is
    in the base framework (System.Drawing.Primitives), so no package reference is needed.
  -->
  <ItemGroup>
    <Using Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HidSharpCore" Version="1.3.0" />
    <PackageReference Include="System.Management" Version="10.0.10" />
  </ItemGroup>

</Project>
