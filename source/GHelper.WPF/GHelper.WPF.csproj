<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>annotations</Nullable>
    <UseWPF>True</UseWPF>
    <!-- WinForms is here only for the tray NotifyIcon; no WinForms UI is created. -->
    <UseWindowsForms>True</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>GHelper.WPF</AssemblyName>
    <RootNamespace>GHelper.WPF</RootNamespace>
    <DebugType>embedded</DebugType>
    <OutputPath>bin\x64\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\x64\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WinForms out of the global usings so System.Windows.* stays unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\standard.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GHelper.Shared\GHelper.Shared.csproj" />
  </ItemGroup>

</Project>
